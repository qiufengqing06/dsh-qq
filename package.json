{
  "name": "dsh-qq",
  "version": "0.7.68",
  "description": "鱼书（Yushu）：官方 QQBot 与个人 QQ（OneBot 11/NapCat）双线路的 DSH 渠道插件。QQ ↔ DSH 会话、人设、记忆、表情、远程控制与审批。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./mock": "./lib/mock.js",
    "./transport": "./lib/transport.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:clean-temps": "node scripts/clean-temp-dirs.mjs --apply"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qq",
    "qqbot",
    "onebot",
    "channel",
    "plugin",
    "napcat",
    "qq-bot",
    "yushu"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "https-proxy-agent": "^7.0.0",
    "undici": "^7.0.0",
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiufengqing06/dsh-yushu.git"
  },
  "homepage": "https://github.com/qiufengqing06/dsh-yushu",
  "bugs": {
    "url": "https://github.com/qiufengqing06/dsh-yushu/issues"
  },
  "author": "qiufengqing06",
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
