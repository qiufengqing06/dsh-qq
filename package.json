{
  "name": "dsh-qq",
  "version": "0.7.59",
  "description": "QQ 渠道插件：QQ 号扫码/QQBot 凭据登录，QQ ↔ DSH 会话双向消息、远程控制与审批（de_channel_send channels=qq）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./mock": "./lib/mock.js",
    "./transport": "./lib/transport.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:clean-temps": "node scripts/clean-temp-dirs.mjs --apply"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "qq",
    "qqbot",
    "onebot",
    "channel",
    "plugin",
    "napcat",
    "qq-bot"
  ],
  "license": "MIT",
  "optionalDependencies": {
    "https-proxy-agent": "^7.0.0",
    "undici": "^7.0.0",
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiufengqing06/dsh-qq.git"
  },
  "homepage": "https://github.com/qiufengqing06/dsh-qq",
  "bugs": {
    "url": "https://github.com/qiufengqing06/dsh-qq/issues"
  },
  "author": "qiufengqing06",
  "publishConfig": {
    "access": "public"
  },
  "private": true
}
